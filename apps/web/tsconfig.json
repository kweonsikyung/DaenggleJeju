{
  "extends": "@daengglejeju/tsconfig/nextjs.json",
  "compilerOptions": {
    "types": ["@vanilla-extract/css"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next.config.js",
    "src/ui/molecules/SearchHeader"
  ],
  "exclude": ["node_modules"]
}
