{
  "name": "@daengglejeju/hooks",
  "version": "0.0.1",
  "description": "Shared React hooks for DaenggleJeju",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup"
  },
  "devDependencies": {
    "@daengglejeju/tsconfig": "workspace:*",
    "@types/react": "^19.1.12",
    "tsup": "^8.5.1",
    "typescript": "^5"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "license": "MIT"
}
